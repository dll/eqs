# ===== EQS 工程快捷服务 环境变量配置 =====
# 文档版本：V3.0
# 更新日期：2026-08-07

# ===== 服务端配置 =====
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=eqs
REDIS_ADDR=localhost:6379
REDIS_PASS=
JWT_SECRET=your_jwt_secret
# P1-09 敏感字段加密密钥（AES-256-GCM；生产环境必填，缺失将拒绝启动）
DATA_ENCRYPTION_KEY=your_field_encryption_key

# ===== 第三方 CAD 渲染引擎（DWG 在线预览） =====
# 指向自建 CAD 转换服务（如 Aspose.CAD 封装服务 / 商业渲染网关）的 HTTP 接口；
# 未配置时 DWG 文件返回"请下载后用 CAD 软件查看"。
CAD_CONVERT_API=

# ===== 短信服务配置（腾讯云短信；填好即真实发送，留空降级内置模拟/拒绝） =====
TENCENT_SMS_SECRET_ID=your_tencent_secret_id
TENCENT_SMS_SECRET_KEY=your_tencent_secret_key
SMS_SDK_APP_ID=your_sms_sdk_app_id
SMS_SIGN_NAME=your_sms_sign_name
SMS_TEMPLATE_ID=your_sms_template_id

# ===== OCR 资质识别（腾讯云 OCR；填好即审核时自动识别扫描件） =====
TENCENT_OCR_SECRET_ID=your_tencent_secret_id
TENCENT_OCR_SECRET_KEY=your_tencent_secret_key

# ===== 微信支付 v3（PAYMENT_PROVIDER=wechat 时启用；留空走 Mock 通道） =====
WXPAY_APPID=your_wx_appid
WXPAY_MCHID=your_mch_id
WXPAY_API_V3_KEY=your_api_v3_key
WXPAY_MCH_SERIAL_NO=your_mch_cert_serial_no
# 商户私钥与平台证书 PEM 文件路径（服务器本地文件）
WXPAY_MCH_PRIVATE_KEY_FILE=/opt/eqs/certs/apiclient_key.pem
WXPAY_PLATFORM_CERT_FILE=/opt/eqs/certs/wechatpay_platform_cert.pem
# 支付回调公网地址（微信服务器可达）
WXPAY_NOTIFY_URL=https://eqs-chzu.tech/api/v1/pay/notify/wechat

# ===== App 推送（DCloud uni-push / 个推；填好即离线推送，留空走 SSE/轮询） =====
PUSH_APP_ID=your_getui_appid
PUSH_APP_KEY=your_getui_appkey
PUSH_MASTER_SECRET=your_getui_master_secret

# ===== 微信小程序配置 =====
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret
WX_MCH_ID=your_mch_id
WX_MCH_KEY=your_mch_key
WX_MCH_CERT=your_mch_cert_path
WX_MCH_KEY_FILE=your_mch_key_file_path

# ===== 微信小程序登录（code2session，V11 新增）=====
# 未配置或 WX_MINI_MOCK=1 时登录降级为 mock（openid_<code>），开发/CI 可用。
WX_MINI_APPID=your_wx_mini_appid
WX_MINI_SECRET=your_wx_mini_appsecret
WX_MINI_MOCK=0

# ===== 腾讯云配置 =====
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key
COS_BUCKET=eqs-files
COS_REGION=ap-guangzhou
CDN_DOMAIN=cdn.eqs.example.com

# ===== AI模型配置 - 国产大模型 =====
# 百度文心一言
BAIDU_API_KEY=your_baidu_api_key
BAIDU_SECRET_KEY=your_baidu_secret_key

# 阿里通义千问
ALIYUN_API_KEY=your_aliyun_api_key
ALIYUN_API_SECRET=your_aliyun_api_secret

# 科大讯飞星火
IFLY_API_KEY=your_ifly_api_key
IFLY_API_SECRET=your_ifly_api_secret
IFLY_APP_ID=your_ifly_app_id

# ===== 前端配置 =====
VITE_API_BASE_URL=https://api.eqs.example.com
VITE_COS_DOMAIN=https://cos.ap-guangzhou.myqcloud.com
VITE_WX_APPID=your_wx_appid

# ===== 部署配置 =====
DEPLOY_ENV=production
LOG_LEVEL=info
