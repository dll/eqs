# ===== EQS 工程快捷服务 环境变量配置 =====
# 文档版本：V3.0
# 更新日期：2026-08-07

# ===== 服务端配置 =====
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=eqs
REDIS_ADDR=localhost:6379
REDIS_PASS=
JWT_SECRET=your_jwt_secret
# P1-09 敏感字段加密密钥（AES-256-GCM；生产环境必填，缺失将拒绝启动）
DATA_ENCRYPTION_KEY=your_field_encryption_key

# ===== 微信小程序配置 =====
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret
WX_MCH_ID=your_mch_id
WX_MCH_KEY=your_mch_key
WX_MCH_CERT=your_mch_cert_path
WX_MCH_KEY_FILE=your_mch_key_file_path

# ===== 腾讯云配置 =====
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key
COS_BUCKET=eqs-files
COS_REGION=ap-guangzhou
CDN_DOMAIN=cdn.eqs.example.com

# ===== AI模型配置 - 国产大模型 =====
# 百度文心一言
BAIDU_API_KEY=your_baidu_api_key
BAIDU_SECRET_KEY=your_baidu_secret_key

# 阿里通义千问
ALIYUN_API_KEY=your_aliyun_api_key
ALIYUN_API_SECRET=your_aliyun_api_secret

# 科大讯飞星火
IFLY_API_KEY=your_ifly_api_key
IFLY_API_SECRET=your_ifly_api_secret
IFLY_APP_ID=your_ifly_app_id

# ===== 短信服务配置 =====
SMS_SECRET_ID=your_sms_secret_id
SMS_SECRET_KEY=your_sms_secret_key
SMS_APP_ID=your_sms_app_id
SMS_SIGN_NAME=your_sms_sign_name

# ===== 前端配置 =====
VITE_API_BASE_URL=https://api.eqs.example.com
VITE_COS_DOMAIN=https://cos.ap-guangzhou.myqcloud.com
VITE_WX_APPID=your_wx_appid

# ===== 部署配置 =====
DEPLOY_ENV=production
LOG_LEVEL=info
